msgstr ""

#: data/im.apodaca.owlet.gschema.xml:122
msgid "Accelerator for win.stop"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:127
msgid "Accelerator for win.insert"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:128
msgid ""
"GTK accelerator string. win.insert copies the transcript to the clipboard "
"and types it into the previously focused window via the keystroke backend."
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:132
msgid "Accelerator for win.dictate"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:133
msgid "GTK accelerator string. Toggles dictation mode on or off."
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:137
msgid "Accelerator for app.preferences"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:138
msgid "GTK accelerator string. Opens the Preferences dialog."
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:142
msgid "Accelerator for app.shortcuts"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:143
msgid "GTK accelerator string. Opens the Keyboard Shortcuts dialog."
