#: data/im.apodaca.owlet.desktop.in:8
msgid "GTK;"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:6
msgid "Path to the GGUF model file used for local transcription"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:7
msgid ""
"Absolute path to a Whisper-compatible GGUF model. When empty, Owlet scans "
"~/.local/share/owlet/models/ for the first *.gguf at startup."
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:11
msgid "Use streaming transcription when available"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:12
msgid ""
"When true and the loaded model supports streaming, partial transcripts are "
"emitted while speaking. When false, the whole clip is transcribed after stop."
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:16
msgid "Language code or 'auto' for detection"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:17
msgid ""
"ISO-639-1 language code passed to the transcribe runtime, or \"auto\" to let "
"the model detect the language."
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:21
msgid "Number of CPU threads for the transcribe.cpp runtime"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:22
msgid ""
"Thread count passed to SessionParams.n_threads. Ignored on GPU backends that "
"don't use CPU threads."
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:26
msgid "Auto-type streamed text into focused window during dictation"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:27
msgid ""
"When true, the streamed transcript is injected via the keystroke backend "
"into whatever window has keyboard focus while Owlet is minimized. When "
"false, dictation records and transcribes but does not inject keystrokes."
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:31
msgid "Delay between keystrokes when simulating typing (ms)"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:32
msgid ""
"Passed to ydotool (--key-delay) or xdotool (--delay). Ignored by the libei "
"backend, which injects events directly."
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:36
msgid "Append a newline after each dictation session"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:37
msgid ""
"When true, a newline is typed after the final transcript of each dictation "
"session. Useful when dictating into a chat composer that sends on Enter."
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:41
msgid "Play sounds when recording starts and stops"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:42
msgid ""
"When true, short tones play after the microphone starts and when the user "
"stops recording or dictation."
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:46
msgid "Show overlay HUD for global shortcut / tray dictation"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:47
msgid ""
"When true, background dictation (global shortcut or tray Dictate) shows an "
"always-on-top live transcript overlay. When false, background dictation "
"still runs without the overlay. In-window Dictate never shows the HUD."
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:51
msgid "Stop dictation after a pause in speech"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:52
msgid ""
"When true, dictation ends automatically after dictation-auto-stop-pause-ms "
"of silence (including if the user never speaks). Record mode is unaffected. "
"When false, dictation stops only via toggle, Stop, or shortcut."
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:56
msgid "Silence duration before dictation auto-stops (ms)"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:57
msgid ""
"How long speech must stay below dictation-auto-stop-threshold before "
"dictation stops. Intended range 500–5000. Only used when dictation-auto-stop "
"is true."
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:61
msgid "RMS energy threshold for speech vs silence"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:62
msgid ""
"Capture chunks at or above this RMS count as speech and reset the auto-stop "
"pause timer. Lower values detect quieter speech (and may hold open in noisy "
"rooms); higher values ignore room noise (and may cut off soft speech). "
"Intended range 0.0001–0.05. Only used when dictation-auto-stop is true."
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:66
msgid "Hide to system tray on window close"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:67
msgid ""
"When true, closing the main window hides Owlet to a StatusNotifierItem tray "
"icon instead of quitting. Use Quit (Ctrl+Q) or the tray Quit item to exit. "
"On GNOME Shell, an AppIndicator / KStatusNotifierItem extension is required "
"for the icon to appear."
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:71
msgid "Keystroke injection backend: auto|libei|ydotool|xdotool"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:72
msgid ""
"Forces a specific backend. \"auto\" picks libei (if built with support) then "
"ydotool then xdotool based on availability and session type."
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:77
msgid ""
"Preferred GPU backend (read-only at runtime; reflects the build-time choice)"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:78
msgid ""
"The resolved backend baked into the binary at build time (auto / hip / "
"vulkan / cpu). Read-only at runtime; the binary was linked against one "
"backend only."
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:82
msgid "Enable flash-attention for the local Whisper model"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:83
msgid ""
"When true, transcribe.cpp session.run is invoked with flash attention "
"enabled. May improve performance on supported models."
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:87
msgid "Transcription source: local|api"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:88
msgid ""
"\"local\" uses the GGUF model on disk. \"api\" sends audio to an OpenAI-"
"compatible endpoint (see api-* keys)."
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:92
msgid "OpenAI-compatible transcription endpoint URL"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:93
msgid ""
"POSTed multipart/form-data with the captured WAV. Defaults to OpenAI; point "
"at any OpenAI-compatible server."
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:97
msgid "Model name sent to the transcription API"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:98
msgid ""
"The \"model\" form field passed to the endpoint. Defaults to OpenAI's "
"whisper-1."
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:102
msgid "Response format requested from the transcription API"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:103
msgid ""
"One of \"json\", \"text\", or \"verbose_json\". Sent as the "
"\"response_format\" form field when supported by the endpoint."
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:107
msgid "Sampling temperature for the transcription API (0.0–1.0)"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:108
msgid ""
"Passed as the \"temperature\" form field. 0.0 is deterministic; 1.0 is "
"maximum randomness."
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:112
msgid "Request English translation from the API"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:113
msgid ""
"When true, sends \"translate=true\" so the API returns an English transcript "
"of whatever language was spoken."
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:117
msgid "Accelerator for win.record"
msgstr ""

#: data/im.apodaca.owlet.gschema.xml:118 data/im.apodaca.owlet.gschema.xml:123
msgid ""
"GTK accelerator string. Applied at startup and re-applied live when changed "
