# Build directory
/build/
/build_*/

#worktrees
.worktrees

# Meson/Ninja artifacts
*.ninja
*.ninja.log
compile_commands.json

# Meson subproject build dirs (sidecar cmake outputs)
/subprojects/*/subprojects/

# Compiled objects / libraries
*.o
*.a
*.so
*.gresource

# Stray glib-compile-schemas output from `ninja test` schema validation
/data/gschemas.compiled

# Editor / VCS
*~
.*.swp
.vscode/
.idea/

# Local pytest venv (see tests/README.md)
/tests/.venv/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Arch makepkg artifacts (midscroll-style in-tree packaging)
/packaging/**/*.pkg.tar.zst
/packaging/**/pkg/
/packaging/**/src/
/packaging/**/*.log

# Debian dpkg-buildpackage artifacts (packaging/debian/build.sh)
/packaging/debian/*.deb
/packaging/debian/*.ddeb
/packaging/debian/*.buildinfo
/packaging/debian/*.changes
/packaging/debian/files
/packaging/debian/*.substvars
/packaging/debian/*.debhelper.log
/packaging/debian/debhelper-build-stamp
/packaging/debian/.debhelper/
/packaging/debian/owlet/
/packaging/debian/owlet-vulkan/
/packaging/debian/owlet-hip/
/debian

# AppImage linuxdeploy artifacts (packaging/appimage/build.sh)
/packaging/appimage/*.AppImage
/packaging/appimage/AppDir/
/packaging/appimage/builddir-*/
/packaging/appimage/.linuxdeploy-cache/
/packaging/appimage/.gst-plugins-minimal/
/packaging/appimage/squashfs-root/