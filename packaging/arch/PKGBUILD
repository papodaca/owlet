pkgbase=owlet
_build_backend=${OWLET_BACKEND:-all}
case "${_build_backend}" in
  all)    pkgname=('owlet' 'owlet-vulkan' 'owlet-hip') ;;
  cpu)    pkgname=('owlet') ;;
  vulkan) pkgname=('owlet-vulkan') ;;
  hip)    pkgname=('owlet-hip') ;;
  *)
    error "OWLET_BACKEND must be one of: all, cpu, vulkan, hip"
    return 1
    ;;
esac
pkgver=0.1.0
pkgrel=1
pkgdesc='Speech-to-text GNOME app using local transcribe.cpp (GTK4/libadwaita)'
url='https://github.com/papodaca/owlet'
license=('GPL-3.0-or-later')
arch=('x86_64' 'aarch64')
install=owlet.install
source=()
sha256sums=()

makedepends=(
  meson
  ninja
  vala
  pkgconf
  cmake
  gcc
  git
  glib2
  appstream
  desktop-file-utils
  gtk4
  libadwaita
  gstreamer
  gst-plugins-base-libs
  libsoup3
  libsecret
  json-glib
  libei
  blas
  cblas
)

if [[ ${_build_backend} == all || ${_build_backend} == vulkan ]]; then
  makedepends+=(vulkan-headers shaderc spirv-headers)
fi

if [[ ${_build_backend} == all || ${_build_backend} == hip ]]; then
  makedepends+=(hip-runtime-amd rocminfo hipblas rocblas)
fi

_common_depends=(
  gtk4
  libadwaita
  gstreamer
  gst-plugins-base-libs
  gst-plugins-good
  gst-plugin-pipewire
  glib2
  libsoup3
  libsecret
  json-glib
  libei
  libx11
  libxext
  libxrandr
  blas
  cblas
  gcc-libs
  desktop-file-utils
)

_common_optdepends=(
  'ydotool: keystroke injection fallback'
  'xdotool: X11 keystroke injection fallback'
  'xdg-desktop-portal: GlobalShortcuts portal'
  'libnotify: notifications from owlet-signal'
)

prepare() {
  cd "${startdir}/../.."
  git submodule update --init --recursive
}

pkgver() {
  cd "${startdir}/../.."
  local tag
  tag=$(git describe --tags --exact-match HEAD 2>/dev/null || true)
  if [[ ${tag} =~ ^v([0-9][^[:space:]]*)$ ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  else
    printf '0.1.0.r%s.%s' \
      "$(git rev-list --count HEAD)" \
      "$(git rev-parse --short HEAD)"
  fi
}

build() {
  cd "${startdir}/../.."
  local common=(
    --prefix=/usr
    --buildtype=plain
  )
  local backends=()

  if [[ ${_build_backend} == all ]]; then
    backends=(cpu vulkan hip)
  else
    backends=("${_build_backend}")
  fi

  local backend
  for backend in "${backends[@]}"; do
    rm -rf "build-${backend}"
    if [[ ${backend} == hip ]]; then
      meson setup build-hip "${common[@]}" -Dgpu_backend=hip \
        '-Damd_targets=gfx1100;gfx1030;gfx906;gfx90a;gfx1200;gfx1201'
    else
      meson setup "build-${backend}" "${common[@]}" -Dgpu_backend="${backend}"
    fi

    ninja -C "build-${backend}"
  done
}

check() {
  cd "${startdir}/../.."
  local check_backend=${_build_backend}
  if [[ ${check_backend} == all ]]; then
    check_backend=cpu
  fi

  meson test -C "build-${check_backend}" --print-errorlogs --suite unit
  meson test -C "build-${check_backend}" --print-errorlogs \
    'Validate desktop file' \
    'Validate appstream file' \
    'Validate schema file'
}

_install_licenses() {
  install -Dm644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
  install -Dm644 subprojects/transcribe.cpp/LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.transcribe.cpp"
}

package_owlet() {
  depends=("${_common_depends[@]}")
  optdepends=("${_common_optdepends[@]}")
  conflicts=('owlet-vulkan' 'owlet-hip')

  cd "${startdir}/../.."
  DESTDIR="${pkgdir}" meson install -C build-cpu
  _install_licenses
}

package_owlet-vulkan() {
  pkgdesc+=' (Vulkan backend)'
  depends=("${_common_depends[@]}" vulkan-icd-loader)
  optdepends=("${_common_optdepends[@]}")
  provides=('owlet')
  conflicts=('owlet')

  cd "${startdir}/../.."
  DESTDIR="${pkgdir}" meson install -C build-vulkan
  _install_licenses
}

package_owlet-hip() {
  pkgdesc+=' (AMD HIP/ROCm backend)'
  # ROCm/HIP toolchain is x86_64-only upstream.
  arch=('x86_64')
  depends=("${_common_depends[@]}" hip-runtime-amd hipblas rocblas)
  optdepends=("${_common_optdepends[@]}")
  provides=('owlet')
  conflicts=('owlet')

  cd "${startdir}/../.."
  DESTDIR="${pkgdir}" meson install -C build-hip
  _install_licenses
}
